{
  "name": "uni-hotspot",
  "version": "0.1.0",
  "private": true,
  "description": "Uni-Hotspot – lokaler Studien-Hub mit lokaler KI (Ollama): Import, Hybrid-Suche, RAG-Chat.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.ts",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs --browser",
    "desktop": "node scripts/start.mjs --desktop",
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "mock-ollama": "node --disable-warning=ExperimentalWarning scripts/mock-ollama.ts",
    "bench": "node --disable-warning=ExperimentalWarning scripts/bench.ts",
    "e2e": "node scripts/e2e-browser.mjs"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "unpdf": "^1.8.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dompurify": "^3.4.16",
    "electron": "44.7.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "katex": "^0.19.0",
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
